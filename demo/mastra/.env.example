OPENAI_API_KEY=your_openai_api_key

# OpenBox endpoint
OPENBOX_URL=https://core.openbox.ai

# Each agent: its API key and the workload private key (PEM) shown when the agent was
# created (IAM v3 workload identity). Agents registered with a DID set *_AGENT_DID and
# *_AGENT_PRIVATE_KEY instead; parent/child handoff tracing needs DIDs on both agents.

# CopilotKit parent/orchestrator agent
OPENBOX_COPILOTKIT_API_KEY=obx_test_or_live_parent_key
OPENBOX_COPILOTKIT_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
OPENBOX_COPILOTKIT_AGENT_DID=did:aip:parent-agent
OPENBOX_COPILOTKIT_AGENT_PRIVATE_KEY=base64_parent_ed25519_seed

# Mastra child/subagent
OPENBOX_MASTRA_API_KEY=obx_test_or_live_child_key
OPENBOX_MASTRA_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
OPENBOX_MASTRA_AGENT_DID=did:aip:child-agent
OPENBOX_MASTRA_AGENT_PRIVATE_KEY=base64_child_ed25519_seed

# Optional debugging
OPENBOX_DEBUG=true
LOG_LEVEL=debug
